    "cli-table3": "^0.6.5",
    "dotenv": "^17.3.1",
    "figlet": "^1.10.0",
    "picocolors": "^1.1.1",
    "pretty-ms": "^9.3.0"
  },
  "devDependencies": {
    "@rsdoctor/rspack-plugin": "^1.5.2",
    "@rslib/core": "^0.16.1",
    "@types/figlet": "^1.7.0",
    "@types/node": "catalog:",
