{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Benchmark Configuration Schema",
  "description": "Schema for cookie banner benchmark configurations",
  "type": "object",
  "required": [
    "name",
    "iterations",
    "runProfile",
    "measurement",
    "cookieBanner",
    "techStack",
    "source",
    "includes",
    "internationalization"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the benchmark test"
    },
    "iterations": {
      "type": "integer",
      "minimum": 1,
      "default": 20,
      "description": "Number of test iterations to run"
    },
    "runProfile": {
      "type": "object",
      "required": ["cacheMode", "networkProfile", "cpuSlowdownMultiplier"],
      "additionalProperties": false,
      "properties": {
        "cacheMode": {
          "type": "string",
          "enum": ["cold", "warm", "mixed"],
          "description": "Cache strategy used for benchmark iterations"
        },
        "networkProfile": {
          "type": "string",
          "enum": ["none", "slow4g", "fast3g"],
          "description": "Network throttling profile"
        },
        "cpuSlowdownMultiplier": {
          "type": "number",
          "minimum": 1,
          "description": "CPU slowdown rate where 1 means no throttling"
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "minSuccessfulIterations",
        "maxFailureRate",
        "stabilityThresholdCv"
      ],
      "additionalProperties": false,
      "properties": {
        "minSuccessfulIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum successful iterations required for a valid run"
        },
        "maxFailureRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum allowed failed iteration ratio"
        },
        "stabilityThresholdCv": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum coefficient of variation before metrics are unstable"
        },
        "networkMonitorMode": {
          "type": "string",
          "enum": ["passive", "route-debug"],
          "description": "Network monitoring mode; route-debug enables request interception for diagnostics"
        }
      }
    },
    "remote": {
      "type": "object",
      "description": "Configuration for remote benchmarking",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable remote benchmarking instead of building locally"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Remote URL to benchmark (required when remote.enabled is true)"
        },
        "headers": {
          "type": "object",
          "description": "Optional HTTP headers to send with requests",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["url"]
      }
    },
    "cookieBanner": {
      "type": "object",
      "required": ["selectors", "serviceHosts"],
      "additionalProperties": false,
      "properties": {
        "selectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CSS selectors to identify cookie banner elements"
        },
        "serviceHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of service hostnames"
        },
        "waitForVisibility": {
          "type": "boolean",
          "default": true,
          "description": "Whether to wait for banner visibility"
        },
        "measureViewportCoverage": {
          "type": "boolean",
          "default": true,
          "description": "Whether to measure viewport coverage"
        },
        "expectedLayoutShift": {
          "type": "boolean",
          "default": false,
          "description": "Whether layout shift is expected"
        },
        "serviceName": {
          "type": "string",
          "description": "Name of the cookie banner service"
        }
      }
    },
    "internationalization": {
      "type": "object",
      "required": ["detection", "stringLoading"],
      "additionalProperties": false,
      "properties": {
        "detection": {
          "type": "string",
          "enum": ["browser", "ip", "manual", "none"],
          "description": "Method used to determine the banner language"
        },
        "stringLoading": {
          "type": "string",
          "enum": ["bundled", "server", "none"],
          "description": "How the banner loads its translation strings"
        }
      }
    },
    "techStack": {
      "type": "object",
      "required": [
        "bundler",
        "bundleType",
        "frameworks",
        "languages",
        "packageManager"
      ],
      "additionalProperties": false,
      "properties": {
        "bundler": {
          "type": "string"
        },
        "bundleType": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["esm", "cjs", "iife", "bundled"]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["esm", "cjs", "iife", "bundled"]
              }
            }
          ]
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["typescript", "javascript"]
          }
        },
        "packageManager": {
          "type": "string"
        },
        "typescript": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["isOpenSource", "license"],
      "additionalProperties": false,
      "properties": {
        "github": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "isOpenSource": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": ["partially"]
            }
          ]
        },
        "license": {
          "type": "string"
        },
        "npm": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "includes": {
      "type": "object",
      "required": ["components"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
